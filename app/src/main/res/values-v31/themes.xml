<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ punya splash sendiri; item harus diulang karena style
         dengan nama sama menimpa seluruh definisi, bukan menambah. -->
    <style name="Theme.DocScanAR" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/ikon_latar</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
    </style>
</resources>
